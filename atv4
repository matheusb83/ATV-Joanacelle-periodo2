
// Questão 04 - Fibonacci e classificacao dos apostadores

#include <stdio.h>

unsigned long long fibonacci(int n) {
    unsigned long long a = 0, b = 1, soma = 0, temp;
    int i;

    for (i = 0; i < n; i++) {
        soma += a;
        temp = a + b;
        a = b;
        b = temp;
    }

    return soma;
}

int primo(unsigned long long numero) {
    unsigned long long i;

    if (numero < 2) {
        return 0;
    }

    for (i = 2; i <= numero / i; i++) {
        if (numero % i == 0) {
            return 0;
        }
    }

    return 1;
}

int main() {
    char nomes[5][50];
    unsigned long long resultados[5];
    int numeros[5];
    int premiados[5] = {0};
    int i, primeiro = -1, segundo = -1, terceiro = -1;
    double media = 0;

    for (i = 0; i < 5; i++) {
        printf("Nome do apostador: ");
        scanf(" %49[^\n]", nomes[i]);

        do {
            printf("Digite um numero inteiro positivo: ");
            scanf("%d", &numeros[i]);
        } while (numeros[i] <= 0);

        resultados[i] = fibonacci(numeros[i]);
        media += resultados[i];
    }

    media = media / 5;

    for (i = 0; i < 5; i++) {
        if (primo(resultados[i])) {
            if (primeiro == -1 || resultados[i] > resultados[primeiro]) {
                primeiro = i;
            }
        }
    }

    if (primeiro != -1) {
        premiados[primeiro] = 1;
    }

    for (i = 0; i < 5; i++) {
        if (premiados[i] == 0 && resultados[i] % 2 == 0) {
            if (segundo == -1 || resultados[i] > resultados[segundo]) {
                segundo = i;
            }
        }
    }

    if (segundo != -1) {
        premiados[segundo] = 1;
    }

    for (i = 0; i < 5; i++) {
        if (premiados[i] == 0 && resultados[i] > media) {
            if (terceiro == -1 || resultados[i] > resultados[terceiro]) {
                terceiro = i;
            }
        }
    }

    printf("\nClassificacao dos vencedores:\n");

    if (primeiro != -1) {
        printf("1 lugar: %s\n", nomes[primeiro]);
    } else {
        printf("1 lugar: Sem vencedor\n");
    }

    if (segundo != -1) {
        printf("2 lugar: %s\n", nomes[segundo]);
    } else {
        printf("2 lugar: Sem vencedor\n");
    }

    if (terceiro != -1) {
        printf("3 lugar: %s\n", nomes[terceiro]);
    } else {
        printf("3 lugar: Sem vencedor\n");
    }

    return 0;
}
